---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { absolute, routes, url, type Lang, type PageKey } from '../lib/routes';
import { getUi } from '../lib/content';
import { bootScript } from '../lib/boot-script.mjs';

interface Props {
	lang: Lang;
	/** The route-map key, or null for pages outside the map (404). */
	page: PageKey | null;
	title: string;
	description: string;
	/** Extra JSON-LD objects for this page. */
	jsonLd?: Record<string, unknown>[];
	showHeaderBrand?: boolean;
	/** Home page: fixed header over the hero, and the once-per-session opening animation. */
	home?: boolean;
	/** Alt text for the share image. */
	ogImageAlt?: string;
}

const {
	lang,
	page,
	title,
	description,
	jsonLd = [],
	showHeaderBrand = true,
	home = false,
	ogImageAlt = 'Zaria Capital',
} = Astro.props;
const ui = await getUi(lang);
const site = Astro.site ?? 'https://zariacapital.es';
const noindex = import.meta.env.ZARIA_BUILD === 'preview';
const canonical = page ? absolute(routes[page][lang], site) : null;
// Share image (1200 x 630), from the redesign pack.
const ogImageUrl = absolute('/og-image.png', site);
---

<!doctype html>
<html lang={lang} dir="ltr" data-intro={home ? '' : undefined}>
	<head>
		<meta charset="utf-8" />
		<script is:inline set:html={bootScript} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<meta name="theme-color" content="#0F1F10" />
		{canonical && <link rel="canonical" href={canonical} />}
		<Font cssVariable="--zc-font-face" preload={[{ weight: '400', style: 'normal', subset: 'latin' }]} />
		<link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
		<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
		<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
		<link rel="manifest" href={url('/site.webmanifest')} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Zaria Capital" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:locale" content="en_GB" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
	</head>
	<body>
		<a class="skip-link" href="#main">{ui.skipLink}</a>
		<Header lang={lang} page={page} ui={ui} showBrand={showHeaderBrand} home={home} />
		<main id="main">
			<slot />
		</main>
		<Footer lang={lang} page={page} ui={ui} home={home} />
	</body>
</html>
