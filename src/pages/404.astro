---
// One bilingual page for any missing URL: English first, then Spanish, each marked with its language.
import Base from '../layouts/Base.astro';
import stacked from '../../brand/logo/svg/zaria-logo-stacked-white.svg?url';
import { routes, url } from '../lib/routes';
---

<Base
	lang="en"
	page={null}
	showHeaderBrand={false}
	title="Page not found | Página no encontrada | Zaria Capital"
	description="The page you were looking for does not exist or has moved. La página que busca no existe o ha cambiado de dirección. Zaria Capital, Madrid and Abu Dhabi."
>
	<div class="not-found"><div class="wrap">
		<a class="not-found__logo" href={url(routes.home.en)} aria-label="Zaria Capital, home">
			<img src={stacked} alt="" width="220" height="107" />
		</a>
		<div class="not-found__langs">
			<section lang="en" aria-labelledby="nf-en">
				<h1 id="nf-en">Page not found</h1>
				<p>The page you were looking for does not exist or has moved.</p>
				<p><a href={url(routes.home.en)}>Go to the Zaria Capital home page</a></p>
			</section>
			<section lang="es" aria-labelledby="nf-es">
				<h2 id="nf-es">Página no encontrada</h2>
				<p>La página que busca no existe o ha cambiado de dirección.</p>
				<p><a href={url(routes.home.es)}>Ir a la página de inicio de Zaria Capital</a></p>
			</section>
		</div>
	</div></div>
</Base>

<style>
	/* Dark ground, so the header (white logo and links) reads over it. */
	.not-found {
		background: var(--zc-ink-deep);
		color: var(--zc-on-dark);
		padding-block: calc(5.5rem + clamp(3rem, 2rem + 5vw, 7rem)) clamp(4rem, 3rem + 5vw, 8rem);
	}
	.not-found h1,
	.not-found h2 {
		color: var(--zc-on-dark-head);
		font-size: var(--fs-h2);
		margin-block-end: var(--s-4);
	}
	.not-found a {
		color: var(--zc-champagne);
	}
	.not-found :focus-visible {
		outline-color: var(--zc-on-dark);
	}
	.not-found__logo {
		display: inline-block;
		margin-block-end: var(--s-8);
	}
	.not-found__logo img {
		width: 220px;
	}
	.not-found__langs {
		display: grid;
		gap: var(--s-7);
	}
	.not-found p + p {
		margin-block-start: var(--s-3);
	}
	@media (min-width: 48em) {
		.not-found__langs {
			grid-template-columns: 1fr 1fr;
			gap: var(--s-8);
			border-block-start: 1px solid var(--zc-hair-dark);
			padding-block-start: var(--s-6);
		}
	}
</style>
