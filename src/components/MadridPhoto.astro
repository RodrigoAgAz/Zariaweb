---
// The house photograph: central Madrid, black and white. Shown only while Zaria holds web rights
// (madridPhotoWebRights in src/content/settings.yaml). Art direction: a wide crop from 768 px;
// below that a square crop on the Metrópolis dome and Gran Vía.
import { getImage } from 'astro:assets';
import wideSrc from '../assets/images/madrid-gran-via-bw.jpg';
import squareSrc from '../assets/images/madrid-gran-via-bw-square.jpg';
import { getSettings } from '../lib/content';

interface Props {
	alt: string;
}
const { alt } = Astro.props;
const { madridPhotoWebRights } = await getSettings();

const wideWidths = [960, 1440, 1920, 2560];
const squareWidths = [480, 800, 1200];
const srcset = async (src: typeof wideSrc, widths: number[], format: 'avif' | 'webp') =>
	(await Promise.all(widths.map((w) => getImage({ src, width: Math.min(w, src.width), format }))))
		.map((img, i) => `${img.src} ${Math.min(widths[i], src.width)}w`)
		.join(', ');
const photo = madridPhotoWebRights
	? {
			wideAvif: await srcset(wideSrc, wideWidths, 'avif'),
			wideWebp: await srcset(wideSrc, wideWidths, 'webp'),
			squareAvif: await srcset(squareSrc, squareWidths, 'avif'),
			squareWebp: await srcset(squareSrc, squareWidths, 'webp'),
			fallback: await getImage({ src: wideSrc, width: 1600, format: 'jpg' }),
		}
	: null;
---

{
	photo && (
		<figure class="madrid-photo">
			<picture>
				<source media="(min-width: 48em)" type="image/avif" srcset={photo.wideAvif} sizes="100vw" />
				<source media="(min-width: 48em)" type="image/webp" srcset={photo.wideWebp} sizes="100vw" />
				<source type="image/avif" srcset={photo.squareAvif} sizes="100vw" />
				<source type="image/webp" srcset={photo.squareWebp} sizes="100vw" />
				<img src={photo.fallback.src} width="1600" height="790" alt={alt} loading="lazy" decoding="async" />
			</picture>
		</figure>
	)
}

<style>
	.madrid-photo img {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
	}
	@media (min-width: 48em) {
		.madrid-photo img {
			aspect-ratio: 21 / 9;
			max-height: 52rem;
			object-position: 40% 62%;
		}
	}
</style>
