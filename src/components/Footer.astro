---
import logoWhite from '../../brand/logo/svg/zaria-logo-horizontal-white.svg?url';
import { legalNav, routes, url, type Lang } from '../lib/routes';
import { getSettings } from '../lib/content';
import { isPublished } from '../lib/published';

interface Props {
	lang: Lang;
	ui: Record<string, any>;
}
const { lang, ui } = Astro.props;
const settings = await getSettings();
const { spain, adgm } = settings.entities;
// Regulatory sentences appear once the owner supplies them; nothing is shown until then.
const regulatory = [spain.regulatoryStatement[lang], adgm.regulatoryStatement[lang]].filter(Boolean) as string[];
const legalLinks = [];
for (const key of legalNav) if (await isPublished(key)) legalLinks.push(key);
// Computed at build time; a scheduled rebuild every 1 January keeps it current (see README).
const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
	<div class="wrap">
		<div class="site-footer__top">
			<a class="site-footer__brand" href={url(routes.home[lang])} aria-label={ui.homeLabel}>
				<img src={logoWhite} alt="" width="230" height="40" />
			</a>
			<nav aria-label={ui.legalNavLabel}>
				<ul role="list" class="site-footer__links">
					{legalLinks.map((key) => <li><a href={url(routes[key][lang])}>{ui.nav[key]}</a></li>)}
				</ul>
			</nav>
		</div>
		<div class="site-footer__small">
			{regulatory.map((sentence) => <p>{sentence}</p>)}
			<p>{ui.footer.notice}</p>
			<p>{ui.footer.copyright.replace('{year}', String(year))}</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-block-start: var(--section-space);
		padding-block: var(--s-8) var(--s-7);
	}
	.site-footer a {
		text-decoration: none;
	}
	.site-footer a:hover {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.3em;
	}
	.site-footer__top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-6);
		padding-block-end: var(--s-6);
		border-block-end: 1px solid var(--zc-logo-ink-soft);
	}
	.site-footer__brand {
		padding: 6px;
		margin: -6px;
	}
	.site-footer__brand img {
		width: 200px;
	}
	.site-footer__links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2) var(--s-6);
		font-size: var(--fs-small);
	}
	.site-footer__small {
		display: grid;
		gap: var(--s-2);
		margin-block-start: var(--s-6);
		font-size: 0.9375rem;
		color: var(--zc-grey-light);
		max-width: 52em;
	}
</style>
