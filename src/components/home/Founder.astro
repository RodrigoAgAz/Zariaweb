---
// 03 Founder (HANDOFF.md "03 Founder"). No photograph. Left: the role line and the name at display
// size. Right: the lead paragraph, then the Career and Boards tables.
import { inline } from '../../lib/content';

interface Props {
	copy: any;
}
const { copy } = Astro.props;
const tables = [
	{ label: copy.careerLabel, rows: copy.career },
	{ label: copy.boardsLabel, rows: copy.boards },
];
---

<section id="founder" class="founder morph mo-founder" aria-labelledby="founder-h">
	<div class="home-wrap">
		<p class="label-row">
			<span class="label-row__num caps lining">03</span>
			<span class="label-row__text caps">{copy.label}</span>
		</p>

		<div class="founder-body">
			<div class="founder-id">
				<p class="caps founder-role">{copy.role}</p>
				<h2 id="founder-h" class="founder-name">
					{copy.name[0]}<br /><em>{copy.name[1].replace(/\*/g, '')}</em>
				</h2>
			</div>

			<div class="founder-detail">
				<p class="founder-lead" set:html={inline(copy.lead)} />
				{
					tables.map((t) => (
						<div class="crows">
							<h3 class="caps crows-label">{t.label}</h3>
							<ul role="list">
								{t.rows.map((r: any) => (
									<li class="crow">
										<span class="crow-firm">{r.firm}</span>
										<span class="crow-role">{r.role}</span>
										<span class="crow-place caps">{r.places.join(' · ')}</span>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.founder {
		background: var(--zc-paper);
		color: var(--zc-text);
		padding-block: var(--home-pad-top) var(--home-pad-bottom);
	}
	.founder-body {
		display: flex;
		flex-wrap: wrap;
		gap: 56px clamp(48px, 6vw, 112px);
		margin-block-start: 72px;
		align-items: flex-start;
	}
	.founder-id {
		flex: 1 1 340px;
		max-width: 520px;
	}
	.founder-role {
		color: var(--zc-gold-text);
	}
	.founder-name {
		margin-block-start: 20px;
		font-size: clamp(56px, 7vw, 112px);
		line-height: 0.92;
		letter-spacing: -0.02em;
		color: var(--zc-logo-ink);
	}
	.founder-name em {
		font-style: italic;
		color: var(--zc-green-dark);
	}
	.founder-detail {
		flex: 999 1 560px;
		min-width: 0;
	}
	.founder-lead {
		margin-block-start: 6px;
		max-width: 30em;
		font-size: clamp(21px, 1.8vw, 26px);
		line-height: 1.45;
		color: var(--zc-lead-on-light);
	}
	.crows {
		margin-block-start: 64px;
	}
	.crows + .crows {
		margin-block-start: 56px;
	}
	.crows-label {
		display: block;
		padding-block-end: 14px;
		color: var(--zc-logo-ink-soft);
		font-weight: 400;
	}
	.crow {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr);
		column-gap: 24px;
		row-gap: 6px;
		align-items: baseline;
		padding-block: 22px;
		border-block-start: 1px solid rgb(27 51 27 / 0.16);
	}
	.crow:last-child {
		border-block-end: 1px solid rgb(27 51 27 / 0.16);
	}
	.crow::before {
		content: '';
		position: absolute;
		inset-inline-start: 0;
		inset-block-start: -1px;
		height: 1px;
		width: 0;
		background: var(--zc-gold);
		transition: width 0.8s var(--ease-wipe);
	}
	.crow-firm {
		font-size: 30px;
		line-height: 1.1;
		color: var(--zc-logo-ink);
		transition: transform 0.6s var(--ease-hover);
	}
	.crow-role {
		font-size: 19px;
		line-height: 1.35;
		color: var(--zc-body-on-light);
	}
	.crow-place {
		color: var(--zc-place-on-light);
		text-align: end;
	}
	@media (hover: hover) and (pointer: fine) {
		.crow:hover::before {
			width: 100%;
		}
		.crow:hover .crow-firm {
			transform: translateX(8px);
		}
	}

	@media (max-width: 53.75em) {
		.founder {
			padding-block: 88px 96px;
		}
		.founder-body {
			display: block;
			margin-block-start: 48px;
		}
		.founder-name {
			margin-block-start: 16px;
			font-size: 64px;
		}
		.founder-lead {
			margin-block-start: 32px;
			font-size: 20px;
		}
		.crows {
			margin-block-start: 48px;
		}
		.crows + .crows {
			margin-block-start: 40px;
		}
		.crows-label {
			padding-block-end: 12px;
		}
		.crow {
			display: flex;
			flex-direction: column;
			gap: 6px;
			padding-block: 18px;
		}
		.crow-firm {
			font-size: 26px;
		}
		.crow-role {
			font-size: 17px;
		}
		.crow-place {
			font-size: 11px;
			text-align: start;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.crow,
		.crow *,
		.crow::before {
			transition: none !important;
		}
	}
</style>
