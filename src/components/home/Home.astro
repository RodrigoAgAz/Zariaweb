---
import ZDevice from '../ZDevice.astro';
import OfficeClock from '../OfficeClock.astro';
import { routes, url, type Lang } from '../../lib/routes';
import { getPage, getUi, inline } from '../../lib/content';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const copy = await getPage<any>('home', lang);
const ui = await getUi(lang);
const whatWeDo = routes.whatWeDo[lang];
---

<section class="hero">
	<div class="wrap hero__inner">
		<h1>{copy.h1}</h1>
		<p class="lead" set:html={inline(copy.lead)} />
	</div>
	<ZDevice />
</section>

<section class="section" aria-labelledby="lines-heading">
	<div class="wrap"><div class="grid">
		<h2 id="lines-heading" class="grid__label">{copy.lines.heading}</h2>
		<ul role="list" class="grid__body lines">
			{
				copy.lines.items.map((item: any) => (
					<li class="lines__item">
						<h3>
							<a href={url(`${whatWeDo}#${item.anchor}`)}>{item.name}</a>
						</h3>
						<p set:html={inline(item.text)} />
					</li>
				))
			}
		</ul>
	</div></div>
</section>

<section class="section section--band cut-start" aria-labelledby="corridors-heading">
	<div class="wrap"><div class="grid">
		<h2 id="corridors-heading" class="grid__label">{copy.corridors.heading}</h2>
		<div class="grid__body corridors-box">
			<ul role="list" class="corridors">
				{copy.corridors.items.map((item: string) => <li>{item}</li>)}
			</ul>
		</div>
	</div></div>
</section>

<section class="section" aria-labelledby="clients-heading">
	<div class="wrap"><div class="grid">
		<h2 id="clients-heading" class="grid__label">{copy.clients.heading}</h2>
		<div class="grid__body">
			<p class="clients__intro">{copy.clients.intro}</p>
			<ul role="list" class="clients">
				{copy.clients.items.map((item: string) => <li set:html={inline(item)} />)}
			</ul>
		</div>
	</div></div>
</section>

<section class="section section--ruled" aria-labelledby="founder-heading">
	<div class="wrap"><div class="grid">
		<h2 id="founder-heading" class="grid__label">{copy.founder.heading}</h2>
		<div class="grid__body founder">
			<p class="lead" set:html={inline(copy.founder.text)} />
			<p><a href={url(routes.people[lang])}>{copy.founder.link}</a></p>
		</div>
	</div></div>
</section>

<section class="section section--ruled" aria-labelledby="offices-heading">
	<div class="wrap"><div class="grid">
		<h2 id="offices-heading" class="grid__label">{copy.offices.heading}</h2>
		<div class="grid__body offices">
			<div class="office">
				<h3>{ui.cities.madrid}</h3>
				<address>Calle Ayala 3<br />28001 Madrid<br />{lang === 'en' ? 'Spain' : 'España'}</address>
				<OfficeClock timeZone="Europe/Madrid" fallback={ui.clock.madridFallback} suffix={ui.clock.suffix} />
			</div>
			<div class="office">
				<h3>{ui.cities.abuDhabi}</h3>
				<address>ADGM<br />{ui.cities.abuDhabi}<br />{lang === 'en' ? 'United Arab Emirates' : 'Emiratos Árabes Unidos'}</address>
				<OfficeClock timeZone="Asia/Dubai" fallback={ui.clock.abuDhabiFallback} suffix={ui.clock.suffix} />
			</div>
		</div>
	</div></div>
</section>

<style>
	/* Hero A: one sentence on white, the Z diagonal entering from the right. */
	.hero {
		position: relative;
		overflow: clip;
		padding-block: clamp(3rem, 2rem + 6vw, 8rem) clamp(13rem, 9rem + 10vw, 16rem);
	}
	.hero :global(.zdev) {
		height: clamp(13rem, 9rem + 10vw, 16rem);
	}
	.hero__inner {
		position: relative;
		z-index: 1;
	}
	.hero h1 {
		max-width: 15.5em;
	}
	.hero .lead {
		margin-block-start: var(--s-6);
	}

	@media (min-width: 64em) {
		.hero {
			padding-block: var(--s-9) calc(var(--s-10) + var(--s-6));
		}
		.hero :global(.zdev) {
			height: 100%;
		}
		.hero h1 {
			max-width: 13.5em;
		}
		.hero .lead {
			max-width: 27em;
		}
	}

	/* What we do */
	.lines__item {
		padding-block: var(--s-5);
		border-block-start: var(--rule);
	}
	.lines__item:first-child {
		border-block-start: 0;
		padding-block-start: 0;
	}
	.lines__item:last-child {
		padding-block-end: 0;
	}
	.lines h3 a {
		text-decoration-color: var(--zc-grey-light);
	}
	.lines h3 a:hover {
		text-decoration-color: currentColor;
	}
	.lines p {
		margin-block-start: var(--s-2);
		max-width: var(--measure);
	}
	@media (min-width: 48em) {
		.lines__item {
			display: grid;
			grid-template-columns: 15rem 1fr;
			column-gap: var(--s-6);
			align-items: baseline;
		}
		.lines p {
			margin-block-start: 0;
		}
	}

	/* Where we work: three corridors whose left ends step down the Z angle. The type scales with
	   the column (container query units) so the longest line, plus its indent, always fits. */
	.corridors-box {
		container-type: inline-size;
	}
	.corridors {
		--row: calc(var(--fs-corridor) * 1.2 + 2 * var(--s-4));
		font-size: var(--fs-corridor);
		line-height: 1.2;
		color: var(--zc-logo-ink);
	}
	.corridors li {
		padding-block: var(--s-4);
		border-block-start: 1px solid var(--zc-grey-light);
	}
	.corridors li:last-child {
		border-block-end: 1px solid var(--zc-grey-light);
	}
	@media (min-width: 48em) {
		.corridors {
			/* About 16.5em of text and indent on the longest line in either language. */
			--fs-corridor: clamp(1.75rem, (100cqi - 3rem) / 16.5, 2.625rem);
		}
		.corridors li {
			--step: 0;
			white-space: nowrap;
			margin-inline-start: calc(var(--step) * var(--row) / tan(var(--zc-angle)));
		}
		.corridors li:nth-child(1) {
			--step: 2;
		}
		.corridors li:nth-child(2) {
			--step: 1;
		}
	}

	/* Who we work with */
	.clients__intro {
		color: var(--zc-grey-accessible);
	}
	.clients {
		margin-block-start: var(--s-3);
		font-size: var(--fs-lead);
		color: var(--zc-logo-ink);
		columns: 2 12rem;
		column-gap: var(--s-6);
	}
	.clients li {
		padding-block: var(--s-1);
		break-inside: avoid;
	}

	/* Founder */
	.founder .lead {
		max-width: 30em;
	}
	.founder p + p {
		margin-block-start: var(--s-4);
	}

	/* Offices */
	.offices {
		display: grid;
		gap: var(--s-6);
	}
	@media (min-width: 40em) {
		.offices {
			grid-template-columns: 1fr 1fr;
		}
	}
	.office h3 {
		margin-block-end: var(--s-3);
	}
	.office address {
		margin-block-end: var(--s-3);
	}
</style>
