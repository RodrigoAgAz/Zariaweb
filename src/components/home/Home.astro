---
// The homepage (redesign, HANDOFF.md "Page structure"): hero, 01 Where we work, 02 What we do,
// 03 Founder. The footer (Base layout) is the Contact anchor.
import Hero from './Hero.astro';
import Reach from './Reach.astro';
import Services from './Services.astro';
import Founder from './Founder.astro';
import { getPage } from '../../lib/content';
import type { Lang } from '../../lib/routes';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const copy = await getPage<any>('home', lang);
---

<Hero copy={copy.hero} h1={copy.h1} />
<Reach copy={{ ...copy.reach, corridors: copy.hero.corridors }} />
<Services copy={copy.services} />
<Founder copy={copy.founder} />
