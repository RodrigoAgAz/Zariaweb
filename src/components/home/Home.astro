---
// The site's one page: statement and corridors, the Madrid photograph, the firm, the founder,
// and contact. Legal pages are linked from the footer.
import ZDevice from '../ZDevice.astro';
import OfficeClock from '../OfficeClock.astro';
import MadridPhoto from '../MadridPhoto.astro';
import Paragraphs from '../Paragraphs.astro';
import { type Lang } from '../../lib/routes';
import { emailHtml, getPage, getPeople, getSettings, getUi } from '../../lib/content';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const copy = await getPage<any>('home', lang);
const ui = await getUi(lang);
const settings = await getSettings();
const [founder] = await getPeople();
const clocks = [
	{ city: ui.cities.madrid, tz: 'Europe/Madrid', fallback: ui.clock.madridFallback },
	{ city: ui.cities.abuDhabi, tz: 'Asia/Dubai', fallback: ui.clock.abuDhabiFallback },
];
---

<section class="hero on-dark" aria-labelledby="hero-heading">
	<ZDevice tone="dark" />
	<div class="wrap hero__inner">
		<div>
			<h1 id="hero-heading">{copy.h1}</h1>
			<div class="hero__corridors">
				<h2 class="visually-hidden">{copy.corridors.label}</h2>
				<ul role="list" class="corridors">
					{copy.corridors.items.map((item: string) => <li>{item}</li>)}
				</ul>
			</div>
		</div>
		<ul role="list" class="hero__clocks">
			{
				clocks.map((c) => (
					<li>
						<span class="hero__city">{c.city}</span>
						<OfficeClock timeZone={c.tz} fallback={c.fallback} suffix={ui.clock.suffix} />
					</li>
				))
			}
		</ul>
	</div>
</section>

<MadridPhoto alt={copy.photoAlt} />

<section class="section" id="firm" aria-labelledby="firm-heading">
	<div class="wrap">
		<div class="grid">
			<h2 id="firm-heading" class="grid__label">{copy.firm.heading}</h2>
			<div class="grid__body text-large">
				<Paragraphs items={copy.firm.paragraphs} />
			</div>
		</div>
	</div>
</section>

{
	founder && (
		<section class="section section--ruled" id="founder" aria-labelledby="founder-heading">
			<div class="wrap">
				<div class="grid">
					<h2 id="founder-heading" class="grid__label">{copy.founder.heading}</h2>
					<div class="grid__body">
						<h3 class="founder__name">{founder.name}</h3>
						<p class="founder__title">{founder.title[lang]}</p>
						<div class="text-large founder__bio">
							<Paragraphs items={founder.bio[lang]} />
						</div>
					</div>
				</div>
			</div>
		</section>
	)
}

<section class="section section--ruled" id="contact" aria-labelledby="contact-heading">
	<div class="wrap">
		<div class="grid">
			<h2 id="contact-heading" class="grid__label">{copy.contact.heading}</h2>
			<div class="grid__body contact">
				{
					copy.contact.offices.map((o: any) => (
						<div class="contact__office">
							<h3>{o.city}</h3>
							<address set:html={o.lines.join('<br />')} />
							<p>
								<a href={o.map} rel="noopener">
									{copy.contact.mapLink}
									<span class="visually-hidden">, {copy.contact.mapContext.replace('{city}', o.city)}</span>
								</a>
							</p>
						</div>
					))
				}
				{
					settings.email && (
						<div class="contact__email">
							<h3>{copy.contact.email}</h3>
							<p set:html={emailHtml(settings.email)} />
						</div>
					)
				}
			</div>
		</div>
	</div>
</section>

<style>
	/* Hero: the statement on the dark green ground, the Z diagonal tone on tone behind it, the
	   three corridors beneath, and the two offices' local time along the bottom. */
	.hero {
		position: relative;
		overflow: clip;
	}
	.hero__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--s-9);
		min-height: clamp(36rem, 84svh, 62rem);
		padding-block: clamp(3rem, 2rem + 5vw, 8rem) var(--s-6);
	}
	.hero h1 {
		max-width: 11em;
	}
	.hero__corridors {
		margin-block-start: clamp(2.5rem, 1.5rem + 4vw, 5rem);
		max-width: 40rem;
	}
	.corridors {
		font-size: clamp(1.375rem, 1.1rem + 1vw, 2.25rem);
		line-height: 1.2;
		color: var(--zc-fill-light);
	}
	.corridors li {
		padding-block: var(--s-3);
		border-block-start: 1px solid var(--zc-logo-ink-soft);
	}
	.hero__clocks {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2) var(--s-8);
	}
	.hero__clocks li {
		display: flex;
		gap: var(--s-3);
		align-items: baseline;
	}
	.hero__city {
		color: var(--zc-white);
	}
	.hero__clocks :global(.office-clock) {
		color: var(--zc-grey-light);
		font-size: inherit;
	}
	.hero :global(.zdev) {
		height: 55%;
	}
	@media (min-width: 64em) {
		.hero :global(.zdev) {
			height: 100%;
		}
	}

	.text-large {
		font-size: var(--fs-lead);
		line-height: 1.45;
		color: var(--zc-text);
		max-width: 32em;
	}
	.text-large :global(p + p) {
		margin-block-start: 0.9em;
	}

	.founder__name {
		font-size: var(--fs-h2);
	}
	.founder__title {
		margin-block-start: var(--s-2);
		color: var(--zc-grey-accessible);
	}
	.founder__bio {
		margin-block-start: var(--s-6);
	}

	.contact {
		display: grid;
		gap: var(--s-7) var(--s-6);
	}
	@media (min-width: 40em) {
		.contact {
			grid-template-columns: 1fr 1fr;
		}
	}
	.contact h3 {
		font-size: var(--fs-h3);
		margin-block-end: var(--s-3);
	}
	.contact address + p {
		margin-block-start: var(--s-3);
	}
	.contact__email {
		grid-column: 1 / -1;
	}
</style>
