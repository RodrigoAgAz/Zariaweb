---
// 01 Where we work (HANDOFF.md "01 Where we work"). Heading, the three corridors, and the map: a
// dotted world map with the firm's network, routes linking the eleven cities to one another, with
// lights running along them in both directions, office rings and city labels. The routes come from
// scripts/map/gen-routes.mjs (map-routes.json and map-routes.css); city points are in the map's
// 1200 x 680 space (scripts/map/map-geometry.json).
// The map is drawn twice, for desktop and for phones, because labels, stroke widths and dot sizes
// differ between the two mockups; only one is displayed at a time.
import routes from './map-routes.json';
import './map-routes.css';
import dotmap from '../../assets/home/zaria-dotmap.svg?url';
import markWhite from '../../../brand/logo/svg/zaria-mark-white.svg?url';

interface Props {
	copy: any;
}
const { copy } = Astro.props;

type City =
	| 'abudhabi'
	| 'madrid'
	| 'newyork'
	| 'sanfrancisco'
	| 'mexico'
	| 'guayaquil'
	| 'buenosaires'
	| 'bogota'
	| 'lima'
	| 'santiago'
	| 'washington';
const pts: Record<City, [number, number]> = {
	abudhabi: [1051.4, 235.8],
	madrid: [743.4, 137.1],
	newyork: [399.6, 135.3],
	sanfrancisco: [157.4, 153.4],
	mexico: [254.7, 266.9],
	guayaquil: [350.7, 400],
	buenosaires: [472.8, 600.1],
	bogota: [381.9, 357.6],
	lima: [367.5, 460.7],
	santiago: [410.5, 593],
	washington: [383, 146.4],
};
// Every city except the two offices gets a dot; the offices get a ring.
const stops: City[] = ['newyork', 'sanfrancisco', 'mexico', 'guayaquil', 'buenosaires', 'bogota', 'lima', 'santiago', 'washington'];
// Label positions: the nearest spot that clears every route, dot and other label (searched with a
// script against the built page; rerun after changing routes).
// (about 10 map units of space on desktop and on phones). Phone office labels are 36 units, the
// largest that fits beside Madrid between the New York, Mexico City and Bogotá routes.
const labels = {
	desktop: [
		{ city: 'abudhabi', x: 1115, y: 264, size: 26, office: true, anchor: 'middle' },
		{ city: 'madrid', x: 751, y: 168, size: 26, office: true },
		{ city: 'newyork', x: 356, y: 115, size: 18 },
		{ city: 'sanfrancisco', x: 101, y: 154, size: 18, anchor: 'middle' },
		{ city: 'mexico', x: 167, y: 289, size: 18 },
		{ city: 'guayaquil', x: 267, y: 398, size: 18 },
		{ city: 'buenosaires', x: 565, y: 622, size: 18, anchor: 'end' },
		{ city: 'bogota', x: 434, y: 380, size: 18, anchor: 'end' },
		{ city: 'lima', x: 320, y: 477, size: 18 },
		{ city: 'santiago', x: 374, y: 615, size: 18, anchor: 'middle' },
		{ city: 'washington', x: 291, y: 153, size: 18 },
	],
	// New York and Washington are about 7px apart on a phone, too close for a label each, so they
	// share one ("New York · Washington") below and left of the pair.
	mobile: [
		{ city: 'abudhabi', x: 979, y: 165, size: 36, office: true },
		{ city: 'madrid', x: 867, y: 183, size: 36, office: true, anchor: 'end' },
		{ city: 'newyork', join: ['newyork', 'washington'], x: 395, y: 103, size: 32, anchor: 'end' },
		{ city: 'sanfrancisco', x: 65, y: 70, size: 32 },
		{ city: 'mexico', x: 99, y: 304, size: 32 },
		{ city: 'guayaquil', x: 335, y: 419, size: 32, anchor: 'end' },
		{ city: 'buenosaires', x: 473, y: 640, size: 32 },
		{ city: 'bogota', x: 258, y: 383, size: 32 },
		{ city: 'lima', x: 356, y: 495, size: 32, anchor: 'end' },
		{ city: 'santiago', x: 342, y: 624, size: 32, anchor: 'middle' },
	],
} as const;
const variants = [
	{ key: 'desktop', glow: 3, dot: 3.5, office: 5.5, ring: 7, ringStroke: 1.2 },
	{ key: 'mobile', glow: 5.5, dot: 8, office: 11, ring: 12, ringStroke: 2.4 },
] as const;
---

<section id="reach" class="reach morph mo-reach" aria-labelledby="reach-h">
	<img class="reach-mark" src={markWhite} alt="" aria-hidden="true" width="842" height="696" loading="lazy" />
	<div class="home-wrap">
		<p class="label-row label-row--dark">
			<span class="label-row__num caps lining">01</span>
			<span class="label-row__text caps">{copy.label}</span>
		</p>

		<div class="reach-body">
			<h2 id="reach-h" class="reach-h">
				{copy.heading[0]}<br /><em>{copy.heading[1].replace(/\*/g, '')}</em>
			</h2>

			<figure class="map" data-map>
				<div class="map-frame">
					<img class="map-dots" src={dotmap} alt="" width="1200" height="680" loading="lazy" />
					{
						variants.map((v) => (
							<svg
								class={`map-svg map-svg--${v.key}`}
								viewBox="0 0 1200 680"
								role="img"
								aria-label={copy.mapLabel}
							>
								<defs>
									<filter id={`zglow-${v.key}`} x="-20%" y="-20%" width="140%" height="140%">
										<feGaussianBlur stdDeviation={v.glow} />
									</filter>
								</defs>
								<g>
									{routes.map((r) => (
										<path class:list={['arc', `zr${r.i}`, { 'arc--office': r.office }]} pathLength="1" d={r.d} />
									))}
								</g>
								<g class="pulses">
									<g filter={`url(#zglow-${v.key})`}>
										{routes.map((r) => (
											<path class={`tail zr${r.i}`} pathLength="1" d={r.d} />
										))}
										{routes.map((r) => (
											<path class={`mid zr${r.i}`} pathLength="1" d={r.d} />
										))}
									</g>
									{routes.map((r) => (
										<path class={`head zr${r.i}`} pathLength="1" d={r.d} />
									))}
								</g>
								<g class="eps">
									{stops.map((city, i) => (
										<circle class={`ep e${i}`} cx={pts[city][0]} cy={pts[city][1]} r={v.dot} />
									))}
								</g>
								<g>
									<circle class="ring" cx={pts.abudhabi[0]} cy={pts.abudhabi[1]} r={v.ring} stroke-width={v.ringStroke} />
									<circle class="ring ring--late" cx={pts.madrid[0]} cy={pts.madrid[1]} r={v.ring} stroke-width={v.ringStroke} />
									<circle class="office" cx={pts.abudhabi[0]} cy={pts.abudhabi[1]} r={v.office} />
									<circle class="office" cx={pts.madrid[0]} cy={pts.madrid[1]} r={v.office} />
								</g>
								<g class="lbls">
									{labels[v.key].map((l, i) => (
										<text
											class:list={['lbl', `t${i}`, { 'lbl--office': 'office' in l && l.office }]}
											x={l.x}
											y={l.y}
											font-size={l.size}
											text-anchor={'anchor' in l ? l.anchor : undefined}
										>
											{'join' in l ? l.join.map((c) => copy.cities[c]).join(' · ') : copy.cities[l.city]}
										</text>
									))}
								</g>
							</svg>
						))
					}
				</div>
			</figure>

			<ul class="corr-group">
				{
					copy.corridors.map((name: string, i: number) => (
						<li class="corr">
							<span class="c-num caps lining">{String(i + 1).padStart(2, '0')}</span>
							<span class="c-name">{name}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<script>
	import '../../scripts/reach.ts';
</script>

<style>
	.reach {
		position: relative;
		/* clip, not hidden: hidden would make the section a scroll container and freeze the map's
		   scroll timeline. */
		overflow: hidden;
		overflow: clip;
		background: var(--zc-logo-ink);
		color: var(--zc-on-dark);
		padding-block: var(--home-pad-top) var(--home-pad-bottom);
	}
	.reach-mark {
		position: absolute;
		inset-inline-end: -14%;
		inset-block-end: -26%;
		height: 1080px;
		width: auto;
		opacity: 0.035;
		pointer-events: none;
		max-width: none;
	}

	/* Desktop: heading and corridors left, map right; stacked under 960px (map between). */
	.reach-body {
		display: grid;
		grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
		grid-template-areas:
			'head map'
			'corridors map';
		grid-template-rows: auto 1fr;
		column-gap: 72px;
		margin-block-start: 72px;
		align-items: start;
	}
	.reach-h {
		grid-area: head;
		font-size: clamp(42px, 4.8vw, 72px);
		line-height: 0.98;
		letter-spacing: -0.012em;
		color: var(--zc-on-dark-head);
	}
	.reach-h em {
		font-style: italic;
		color: var(--zc-champagne);
	}
	.corr-group {
		grid-area: corridors;
		margin-block-start: 56px;
		display: flex;
		flex-direction: column;
	}
	.map {
		grid-area: map;
		margin: 0;
		min-width: 0;
		view-timeline-name: --map;
	}
	.map-frame {
		position: relative;
		aspect-ratio: 1200 / 680;
	}
	.map-dots {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0.2;
		-webkit-mask-image: radial-gradient(ellipse 74% 72% at 50% 46%, #000 58%, transparent 100%);
		mask-image: radial-gradient(ellipse 74% 72% at 50% 46%, #000 58%, transparent 100%);
	}
	.map-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	.map-svg--mobile {
		display: none;
	}

	/* Corridors: a plain list; the map always shows the whole network. */
	.corr-group {
		list-style: none;
		padding: 0;
	}
	.corr {
		display: grid;
		grid-template-columns: 56px minmax(0, 1fr);
		align-items: baseline;
		margin: 0;
		padding: 22px 0 24px;
		border-block-start: 1px solid var(--zc-hair-dark);
	}
	.corr:last-child {
		border-block-end: 1px solid var(--zc-hair-dark);
	}
	.c-num {
		color: var(--zc-gold-light);
	}
	.c-name {
		font-size: 26px;
		line-height: 1.15;
		color: var(--zc-on-dark);
	}

	/* Network: routes, travelling lights, dots, rings and labels */
	.arc {
		fill: none;
		stroke: var(--zc-gold);
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
		transition: opacity 0.7s ease;
	}
	.arc--office {
		stroke-width: 2.2;
		stroke: var(--zc-gold-light);
	}
	.head,
	.mid,
	.tail {
		fill: none;
		stroke-linecap: round;
		animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
		animation-iteration-count: infinite;
		animation-fill-mode: both;
		transition: opacity 0.7s;
	}
	/* Each route has its own light, running from one city to the other, resting, and repeating.
	   Paths use pathLength 1, so --k (1 / the route's length in map units) keeps the light the same
	   size on every route, and each route's cycle is timed to its length (about 220 units a second).
	   The keyframes use plain numbers: Chrome will not interpolate an offset written with var(). */
	.head {
		stroke: #fff6dc;
		stroke-width: 2.4;
		stroke-dasharray: calc(6 * var(--k)) 2;
		stroke-dashoffset: 0.02;
		animation-name: reach-run-head;
	}
	.mid {
		stroke: #f3dc9c;
		stroke-width: 4;
		stroke-opacity: 0.7;
		stroke-dasharray: calc(24 * var(--k)) 2;
		stroke-dashoffset: 0.075;
		animation-name: reach-run-mid;
	}
	.tail {
		stroke: #e0bd6a;
		stroke-width: 7;
		stroke-opacity: 0.35;
		stroke-dasharray: calc(56 * var(--k)) 2;
		stroke-dashoffset: 0.17;
		animation-name: reach-run-tail;
	}
	@keyframes reach-run-head {
		0% {
			stroke-dashoffset: 0.02;
		}
		70%,
		100% {
			stroke-dashoffset: -1;
		}
	}
	@keyframes reach-run-mid {
		0% {
			stroke-dashoffset: 0.075;
		}
		70%,
		100% {
			stroke-dashoffset: -1;
		}
	}
	@keyframes reach-run-tail {
		0% {
			stroke-dashoffset: 0.17;
		}
		70%,
		100% {
			stroke-dashoffset: -1;
		}
	}
	.ep {
		fill: var(--zc-on-dark);
		transition: fill-opacity 0.7s;
	}
	.ring {
		fill: none;
		stroke: var(--zc-gold-light);
		transform-box: fill-box;
		transform-origin: center;
		animation: reach-ring 3s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
	}
	.ring--late {
		animation-delay: 1.5s;
	}
	@keyframes reach-ring {
		0% {
			transform: scale(0.5);
			opacity: 0.9;
		}
		100% {
			transform: scale(3.6);
			opacity: 0;
		}
	}
	.office {
		fill: var(--zc-gold-light);
	}
	.lbl {
		font-family: inherit;
		font-style: italic;
		fill: var(--zc-map-label);
	}
	.lbl--office {
		fill: var(--zc-on-dark-head);
	}

	/* Time-based draw (browsers without scroll timelines): with JavaScript, the routes wait for the
	   section to enter the viewport, then draw one after another; without it, they are simply drawn.
	   Per-route delays and scroll ranges are in map-routes.css. */
	:global(.js) .map:not(.is-in) .arc {
		stroke-dashoffset: 1;
	}
	:global(.js) .map:not(.is-in) .ep,
	:global(.js) .map:not(.is-in) .lbl,
	:global(.js) .map:not(.is-in) .pulses {
		opacity: 0;
	}
	:global(.js) .map:not(.is-in) .pulses path {
		animation-play-state: paused;
	}
	:global(.js) .map.is-in .arc {
		stroke-dashoffset: 1;
		animation: zc-draw 1.2s cubic-bezier(0.65, 0, 0.35, 1) forwards;
	}
	:global(.js) .map.is-in .ep,
	:global(.js) .map.is-in .lbl {
		opacity: 0;
		animation: zc-appear 0.9s ease forwards;
	}
	:global(.js) .map.is-in .lbl {
		animation-duration: 1.2s;
	}
	.map.is-in .e0 {
		animation-delay: 1.95s;
	}
	.map.is-in .e1 {
		animation-delay: 2.4s;
	}
	.map.is-in .e2 {
		animation-delay: 2.85s;
	}
	.map.is-in .e3 {
		animation-delay: 3.3s;
	}
	.map.is-in .e4 {
		animation-delay: 3.75s;
	}
	.map.is-in .e5 {
		animation-delay: 4.2s;
	}
	.map.is-in .e6 {
		animation-delay: 4.65s;
	}
	.map.is-in .e7 {
		animation-delay: 5.1s;
	}
	.map.is-in .e8 {
		animation-delay: 5.55s;
	}
	.map.is-in .t0 {
		animation-delay: 0.4s;
	}
	.map.is-in .t1 {
		animation-delay: 1s;
	}
	.map.is-in .t2 {
		animation-delay: 2s;
	}
	.map.is-in .t3 {
		animation-delay: 2.45s;
	}
	.map.is-in .t4 {
		animation-delay: 2.9s;
	}
	.map.is-in .t5 {
		animation-delay: 3.35s;
	}
	.map.is-in .t6 {
		animation-delay: 3.8s;
	}
	.map.is-in .t7 {
		animation-delay: 4.25s;
	}
	.map.is-in .t8 {
		animation-delay: 4.7s;
	}
	.map.is-in .t9 {
		animation-delay: 5.15s;
	}
	.map.is-in .t10 {
		animation-delay: 5.6s;
	}

	/* Scroll-linked draw where supported: the routes draw with the scroll, one after another. Scoped to
	   JavaScript so that a page without it always shows the route drawn. */
	@supports (animation-timeline: view()) {
		:global(.js) .map .arc,
		:global(.js) .map.is-in .arc {
			stroke-dashoffset: 1;
			/* Longhands only: the minifier would fold a shorthand and the timeline into one invalid declaration. */
			animation-name: zc-draw;
			animation-duration: auto;
			animation-timing-function: linear;
			animation-fill-mode: both;
			animation-timeline: --map;
			animation-delay: 0s !important;
		}
		:global(.js) .map .ep,
		:global(.js) .map .lbl,
		:global(.js) .map.is-in .ep,
		:global(.js) .map.is-in .lbl {
			opacity: 0;
			/* Longhands only: the minifier would fold a shorthand and the timeline into one invalid declaration. */
			animation-name: zc-appear;
			animation-duration: auto;
			animation-timing-function: linear;
			animation-fill-mode: both;
			animation-timeline: --map;
			animation-range: cover 28% cover 42%;
			animation-delay: 0s !important;
		}
		:global(.js) .map .pulses,
		:global(.js) .map:not(.is-in) .pulses {
			opacity: 0;
			/* Longhands only: the minifier would fold a shorthand and the timeline into one invalid declaration. */
			animation-name: zc-appear;
			animation-duration: auto;
			animation-timing-function: linear;
			animation-fill-mode: both;
			animation-timeline: --map;
			animation-range: cover 38% cover 45%;
		}
		:global(.js) .map:not(.is-in) .pulses path {
			animation-play-state: running;
		}
	}

	/* Stacked under 960px */
	@media (max-width: 60em) {
		.reach-body {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				'head'
				'map'
				'corridors';
			grid-template-rows: auto;
		}
		.map {
			margin-block-start: 44px;
		}
		.corr-group {
			margin-block-start: 40px;
		}
	}

	/* Phones (Mobile.dc.html) */
	@media (max-width: 53.75em) {
		.reach {
			padding-block: 88px 96px;
		}
		.reach-mark {
			inset-inline-end: -50%;
			inset-block-end: -8%;
			height: 620px;
		}
		.reach-body {
			margin-block-start: 48px;
		}
		.reach-h {
			font-size: 46px;
		}
		/* The map runs edge to edge: the 1200 x 680 frame is 40px wider than the screen and shifted
		   20px left, cropped by the figure. */
		.map {
			margin-inline: calc(-1 * var(--gutter));
			overflow: hidden;
		}
		.map-frame {
			width: calc(100% + 40px);
			margin-inline-start: -20px;
		}
		.map-dots {
			opacity: 0.22;
			-webkit-mask-image: radial-gradient(ellipse 72% 74% at 50% 46%, #000 58%, transparent 100%);
			mask-image: radial-gradient(ellipse 72% 74% at 50% 46%, #000 58%, transparent 100%);
		}
		.map-svg--desktop {
			display: none;
		}
		.map-svg--mobile {
			display: block;
		}
		.map-svg--mobile .arc,
		.map-svg--mobile .head,
		.map-svg--mobile .mid,
		.map-svg--mobile .tail {
			vector-effect: non-scaling-stroke;
		}
		.map-svg--mobile .arc {
			stroke-width: 1.2;
		}
		.map-svg--mobile .arc--office {
			stroke-width: 1.7;
		}
		.map-svg--mobile .head {
			stroke-width: 2;
		}
		.map-svg--mobile .mid {
			stroke-width: 3.4;
		}
		.map-svg--mobile .tail {
			stroke-width: 5.5;
		}
		.corr {
			grid-template-columns: 44px minmax(0, 1fr);
			padding: 20px 0 22px;
		}
		.c-name {
			font-size: 22px;
		}
	}

	/* Reduced motion: route drawn, labels shown, no light, no rings. */
	@media (prefers-reduced-motion: reduce) {
		.reach *,
		.reach *::before {
			animation: none !important;
			transition: none !important;
		}
		.reach .arc {
			stroke-dashoffset: 0 !important;
		}
		.reach .ep,
		.reach .lbl {
			opacity: 1 !important;
		}
		.reach .pulses {
			opacity: 0 !important;
		}
	}
</style>
