---
// 01 Where we work (HANDOFF.md "01 Where we work"). Heading, the corridor toggle, and the route map:
// a dotted world map with six routes radiating from Abu Dhabi to each city, office rings, city
// labels and a light travelling along every route. Geometry from scripts/map/map-geometry.json (1200 x 680 space).
// The map is drawn twice, for desktop and for phones, because labels, stroke widths and dot sizes
// differ between the two mockups; only one is displayed at a time.
import dotmap from '../../assets/home/zaria-dotmap.svg?url';
import markWhite from '../../../brand/logo/svg/zaria-mark-white.svg?url';

interface Props {
	copy: any;
}
const { copy } = Astro.props;

type City =
	| 'abudhabi'
	| 'madrid'
	| 'newyork'
	| 'sanfrancisco'
	| 'mexico'
	| 'guayaquil'
	| 'buenosaires'
	| 'bogota'
	| 'lima'
	| 'santiago'
	| 'washington';
const pts: Record<City, [number, number]> = {
	abudhabi: [1051.4, 235.8],
	madrid: [743.4, 137.1],
	newyork: [399.6, 135.3],
	sanfrancisco: [157.4, 153.4],
	mexico: [254.7, 266.9],
	guayaquil: [350.7, 400],
	buenosaires: [472.8, 600.1],
	bogota: [381.9, 357.6],
	lima: [367.5, 460.7],
	santiago: [410.5, 593],
	washington: [383, 146.4],
};
// Every route starts in Abu Dhabi. Corridor grouping for the toggle: Southern Europe and Latin
// America = Madrid, Mexico City, Guayaquil, Buenos Aires, Bogotá, Lima, Santiago; United States = New York,
// San Francisco, Washington;
// the Middle East is the hub, so it keeps every route lit.
const legs = [
	{ group: 'eu', d: 'M1051.4 235.8Q919.1 118.7 743.4 137.1' },
	{ group: 'us', d: 'M1051.4 235.8Q751.6 16.1 399.6 135.3' },
	{ group: 'us', d: 'M1051.4 235.8Q629.1 -73.6 157.4 153.4' },
	{ group: 'eu', d: 'M1051.4 235.8Q645.6 60.1 254.7 266.9' },
	{ group: 'eu', d: 'M1051.4 235.8Q668.2 177.8 350.7 400' },
	{ group: 'eu', d: 'M1051.4 235.8Q725.7 360.1 472.8 600.1' },
	{ group: 'eu', d: 'M1051.4 235.8Q688.6 142.7 381.9 357.6' },
	{ group: 'eu', d: 'M1051.4 235.8Q671.2 232.0 367.5 460.7' },
	{ group: 'eu', d: 'M1051.4 235.8Q677.4 318.3 410.5 593' },
	{ group: 'us', d: 'M1051.4 235.8Q736.0 50.7 383 146.4' },
];
// City dots appear as each route arrives.
const stops: { city: City; group: string }[] = [
	{ city: 'newyork', group: 'us' },
	{ city: 'sanfrancisco', group: 'us' },
	{ city: 'mexico', group: 'eu' },
	{ city: 'guayaquil', group: 'eu' },
	{ city: 'buenosaires', group: 'eu' },
	{ city: 'bogota', group: 'eu' },
	{ city: 'lima', group: 'eu' },
	{ city: 'santiago', group: 'eu' },
	{ city: 'washington', group: 'us' },
];
// Label positions: searched for the nearest spot that clears every route, dot and other label
// (about 10 map units of space on desktop and on phones). Phone office labels are 36 units, the
// largest that fits beside Madrid between the New York, Mexico City and Bogotá routes.
const labels = {
	desktop: [
		{ city: 'abudhabi', x: 1069, y: 267, size: 26, office: true },
		{ city: 'madrid', x: 659, y: 186, size: 26, office: true },
		{ city: 'newyork', x: 360, y: 117, size: 18, anchor: 'middle' },
		{ city: 'sanfrancisco', x: 221, y: 174, size: 18, anchor: 'middle' },
		{ city: 'mexico', x: 247, y: 261, size: 18, anchor: 'end' },
		{ city: 'guayaquil', x: 338, y: 406, size: 18, anchor: 'end' },
		{ city: 'buenosaires', x: 423, y: 633, size: 18 },
		{ city: 'bogota', x: 370, y: 364, size: 18, anchor: 'end' },
		{ city: 'lima', x: 355, y: 467, size: 18, anchor: 'end' },
		{ city: 'santiago', x: 401, y: 623, size: 18, anchor: 'end' },
		{ city: 'washington', x: 365, y: 146, size: 18, anchor: 'end' },
	],
	// New York and Washington are about 7px apart on a phone, too close for a label each, so they
	// share one ("New York · Washington") below and left of the pair.
	mobile: [
		{ city: 'abudhabi', x: 1134, y: 306, size: 36, office: true, anchor: 'end' },
		{ city: 'madrid', x: 627, y: 197, size: 36, office: true },
		{ city: 'newyork', join: ['newyork', 'washington'], x: 380, y: 195, size: 32, anchor: 'end' },
		{ city: 'sanfrancisco', x: 145, y: 108, size: 32, anchor: 'middle' },
		{ city: 'mexico', x: 110, y: 309, size: 32 },
		{ city: 'guayaquil', x: 334, y: 412, size: 32, anchor: 'end' },
		{ city: 'buenosaires', x: 495, y: 649, size: 32 },
		{ city: 'bogota', x: 366, y: 364, size: 32, anchor: 'end' },
		{ city: 'lima', x: 350, y: 476, size: 32, anchor: 'end' },
		{ city: 'santiago', x: 351, y: 648, size: 32, anchor: 'middle' },
	],
} as const;
const variants = [
	{ key: 'desktop', glow: 3, dot: 3.5, office: 5.5, ring: 7, ringStroke: 1.2 },
	{ key: 'mobile', glow: 5.5, dot: 8, office: 11, ring: 12, ringStroke: 2.4 },
] as const;
const corridorGroups = ['eu', 'me', 'us'];
---

<section id="reach" class="reach morph mo-reach" aria-labelledby="reach-h">
	<img class="reach-mark" src={markWhite} alt="" aria-hidden="true" width="842" height="696" loading="lazy" />
	<div class="home-wrap">
		<p class="label-row label-row--dark">
			<span class="label-row__num caps lining">01</span>
			<span class="label-row__text caps">{copy.label}</span>
		</p>

		<div class="reach-body">
			<h2 id="reach-h" class="reach-h">
				{copy.heading[0]}<br /><em>{copy.heading[1].replace(/\*/g, '')}</em>
			</h2>

			<figure class="map" data-map data-sel="all">
				<div class="map-frame">
					<img class="map-dots" src={dotmap} alt="" width="1200" height="680" loading="lazy" />
					{
						variants.map((v) => (
							<svg
								class={`map-svg map-svg--${v.key}`}
								viewBox="0 0 1200 680"
								role="img"
								aria-label={copy.mapLabel}
							>
								<defs>
									<filter id={`zglow-${v.key}`} x="-20%" y="-20%" width="140%" height="140%">
										<feGaussianBlur stdDeviation={v.glow} />
									</filter>
								</defs>
								<g>
									{legs.map((leg, i) => (
										<path class={`arc l${i} g-${leg.group} g-me`} pathLength="1" d={leg.d} />
									))}
								</g>
								<g class="pulses">
									<g filter={`url(#zglow-${v.key})`}>
										{legs.map((leg, i) => (
											<path class={`tail c${i} g-${leg.group} g-me`} pathLength="1" d={leg.d} />
										))}
										{legs.map((leg, i) => (
											<path class={`mid c${i} g-${leg.group} g-me`} pathLength="1" d={leg.d} />
										))}
									</g>
									{legs.map((leg, i) => (
										<path class={`head c${i} g-${leg.group} g-me`} pathLength="1" d={leg.d} />
									))}
								</g>
								<g class="eps">
									{stops.map((s, i) => (
										<circle class={`ep e${i} g-${s.group} g-me`} cx={pts[s.city][0]} cy={pts[s.city][1]} r={v.dot} />
									))}
								</g>
								<g>
									<circle class="ring" cx={pts.abudhabi[0]} cy={pts.abudhabi[1]} r={v.ring} stroke-width={v.ringStroke} />
									<circle class="ring ring--late" cx={pts.madrid[0]} cy={pts.madrid[1]} r={v.ring} stroke-width={v.ringStroke} />
									<circle class="office" cx={pts.abudhabi[0]} cy={pts.abudhabi[1]} r={v.office} />
									<circle class="office" cx={pts.madrid[0]} cy={pts.madrid[1]} r={v.office} />
								</g>
								<g class="lbls">
									{labels[v.key].map((l, i) => (
										<text
											class:list={['lbl', `t${i}`, { 'lbl--office': 'office' in l && l.office }]}
											x={l.x}
											y={l.y}
											font-size={l.size}
											text-anchor={'anchor' in l ? l.anchor : undefined}
										>
											{'join' in l ? l.join.map((c) => copy.cities[c]).join(' · ') : copy.cities[l.city]}
										</text>
									))}
								</g>
							</svg>
						))
					}
				</div>
			</figure>

			<div class="corr-group" role="group" aria-label={copy.toggleLabel} data-corridor-toggle>
				{
					corridorGroups.map((g, i) => (
						<button type="button" class="corr" aria-pressed="false" data-group={g}>
							<span class="c-num caps lining">{String(i + 1).padStart(2, '0')}</span>
							<span class="c-name">{copy.corridors[i]}</span>
							<span class="c-mark" aria-hidden="true">+</span>
						</button>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	import '../../scripts/reach.ts';
</script>

<style>
	.reach {
		position: relative;
		/* clip, not hidden: hidden would make the section a scroll container and freeze the map's
		   scroll timeline. */
		overflow: hidden;
		overflow: clip;
		background: var(--zc-logo-ink);
		color: var(--zc-on-dark);
		padding-block: var(--home-pad-top) var(--home-pad-bottom);
	}
	.reach-mark {
		position: absolute;
		inset-inline-end: -14%;
		inset-block-end: -26%;
		height: 1080px;
		width: auto;
		opacity: 0.035;
		pointer-events: none;
		max-width: none;
	}

	/* Desktop: heading and toggles left, map right; stacked under 960px (map between). */
	.reach-body {
		display: grid;
		grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
		grid-template-areas:
			'head map'
			'toggles map';
		grid-template-rows: auto 1fr;
		column-gap: 72px;
		margin-block-start: 72px;
		align-items: start;
	}
	.reach-h {
		grid-area: head;
		font-size: clamp(42px, 4.8vw, 72px);
		line-height: 0.98;
		letter-spacing: -0.012em;
		color: var(--zc-on-dark-head);
	}
	.reach-h em {
		font-style: italic;
		color: var(--zc-champagne);
	}
	.corr-group {
		grid-area: toggles;
		margin-block-start: 56px;
		display: flex;
		flex-direction: column;
	}
	.map {
		grid-area: map;
		margin: 0;
		min-width: 0;
		view-timeline-name: --map;
	}
	.map-frame {
		position: relative;
		aspect-ratio: 1200 / 680;
	}
	.map-dots {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0.2;
		-webkit-mask-image: radial-gradient(ellipse 74% 72% at 50% 46%, #000 58%, transparent 100%);
		mask-image: radial-gradient(ellipse 74% 72% at 50% 46%, #000 58%, transparent 100%);
	}
	.map-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	.map-svg--mobile {
		display: none;
	}

	/* Corridor toggle */
	.corr {
		position: relative;
		display: grid;
		grid-template-columns: 56px minmax(0, 1fr) 24px;
		align-items: baseline;
		width: 100%;
		min-height: 44px;
		margin: 0;
		padding: 22px 0 24px;
		border: 0;
		border-block-start: 1px solid var(--zc-hair-dark);
		background: none;
		font: inherit;
		color: inherit;
		text-align: start;
		cursor: pointer;
		transition: color 0.4s;
	}
	.corr:last-child {
		border-block-end: 1px solid var(--zc-hair-dark);
	}
	.corr::before {
		content: '';
		position: absolute;
		inset-inline-start: 0;
		inset-block-start: -1px;
		height: 1px;
		width: 100%;
		background: var(--zc-gold-light);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.7s var(--ease-wipe);
	}
	.corr[aria-pressed='true']::before {
		transform: scaleX(1);
	}
	.c-num {
		color: rgb(243 240 232 / 0.5);
		transition: color 0.4s;
	}
	.c-name {
		font-size: 26px;
		line-height: 1.15;
		color: rgb(243 240 232 / 0.7);
		transition: color 0.4s;
	}
	.c-mark {
		font-size: 20px;
		color: rgb(243 240 232 / 0.35);
		transition:
			transform 0.5s,
			color 0.4s;
	}
	.corr:hover .c-name,
	.corr[aria-pressed='true'] .c-name {
		color: var(--zc-on-dark);
	}
	.corr[aria-pressed='true'] .c-num,
	.corr[aria-pressed='true'] .c-mark {
		color: var(--zc-gold-light);
	}
	.corr[aria-pressed='true'] .c-mark {
		transform: rotate(45deg);
	}
	.corr:focus-visible {
		outline: 2px solid var(--zc-on-dark);
		outline-offset: 4px;
	}

	/* Route: legs, travelling light, dots, rings and labels */
	.arc {
		fill: none;
		stroke: var(--zc-gold);
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
		transition: opacity 0.7s ease;
	}
	.arc.l0 {
		stroke-width: 2.2;
		stroke: var(--zc-gold-light);
	}
	.head,
	.mid,
	.tail {
		fill: none;
		stroke-linecap: round;
		animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
		animation-iteration-count: infinite;
		animation-fill-mode: both;
		transition: opacity 0.7s;
	}
	/* Each route has its own light, running from Abu Dhabi to the city, resting, and repeating.
	   Paths use pathLength 1, so --k (1 / the route's length in map units) keeps the light the same
	   size on every route, and each route's cycle is timed to its length (about 220 units a second).
	   The keyframes use plain numbers: Chrome will not interpolate an offset written with var(). */
	.head {
		stroke: #fff6dc;
		stroke-width: 2.4;
		stroke-dasharray: calc(6 * var(--k)) 2;
		stroke-dashoffset: 0.02;
		animation-name: reach-run-head;
	}
	.mid {
		stroke: #f3dc9c;
		stroke-width: 4;
		stroke-opacity: 0.7;
		stroke-dasharray: calc(24 * var(--k)) 2;
		stroke-dashoffset: 0.075;
		animation-name: reach-run-mid;
	}
	.tail {
		stroke: #e0bd6a;
		stroke-width: 7;
		stroke-opacity: 0.35;
		stroke-dasharray: calc(56 * var(--k)) 2;
		stroke-dashoffset: 0.17;
		animation-name: reach-run-tail;
	}
	@keyframes reach-run-head {
		0% {
			stroke-dashoffset: 0.02;
		}
		70%,
		100% {
			stroke-dashoffset: -1;
		}
	}
	@keyframes reach-run-mid {
		0% {
			stroke-dashoffset: 0.075;
		}
		70%,
		100% {
			stroke-dashoffset: -1;
		}
	}
	@keyframes reach-run-tail {
		0% {
			stroke-dashoffset: 0.17;
		}
		70%,
		100% {
			stroke-dashoffset: -1;
		}
	}
	/* Lengths: Madrid 334, New York 688, San Francisco 949, Mexico City 827, Guayaquil 738,
	   Buenos Aires 688, Bogotá 704, Lima 734, Santiago 745, Washington 694. The lights start once the routes are drawn, a little apart. */
	.c0 {
		--k: 0.002998;
		animation-duration: 2.2s;
		animation-delay: 3.4s;
	}
	.c1 {
		--k: 0.001453;
		animation-duration: 4.5s;
		animation-delay: 3.9s;
	}
	.c2 {
		--k: 0.001054;
		animation-duration: 6.2s;
		animation-delay: 4.4s;
	}
	.c3 {
		--k: 0.001209;
		animation-duration: 5.4s;
		animation-delay: 4.9s;
	}
	.c4 {
		--k: 0.001354;
		animation-duration: 4.8s;
		animation-delay: 5.4s;
	}
	.c5 {
		--k: 0.001453;
		animation-duration: 4.5s;
		animation-delay: 5.9s;
	}
	.c6 {
		--k: 0.001421;
		animation-duration: 4.6s;
		animation-delay: 6.4s;
	}
	.c7 {
		--k: 0.001363;
		animation-duration: 4.8s;
		animation-delay: 6.9s;
	}
	.c8 {
		--k: 0.001343;
		animation-duration: 4.8s;
		animation-delay: 7.4s;
	}
	.c9 {
		--k: 0.001442;
		animation-duration: 4.5s;
		animation-delay: 7.9s;
	}
	.ep {
		fill: var(--zc-on-dark);
		transition: fill-opacity 0.7s;
	}
	.ring {
		fill: none;
		stroke: var(--zc-gold-light);
		transform-box: fill-box;
		transform-origin: center;
		animation: reach-ring 3s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
	}
	.ring--late {
		animation-delay: 1.5s;
	}
	@keyframes reach-ring {
		0% {
			transform: scale(0.5);
			opacity: 0.9;
		}
		100% {
			transform: scale(3.6);
			opacity: 0;
		}
	}
	.office {
		fill: var(--zc-gold-light);
	}
	.lbl {
		font-family: inherit;
		font-style: italic;
		fill: var(--zc-map-label);
	}
	.lbl--office {
		fill: var(--zc-on-dark-head);
	}

	/* Corridor selection dims every other corridor. */
	.map[data-sel='eu'] .arc:not(.g-eu),
	.map[data-sel='me'] .arc:not(.g-me),
	.map[data-sel='us'] .arc:not(.g-us) {
		opacity: 0.12;
	}
	.map[data-sel='eu'] .pulses path:not(.g-eu),
	.map[data-sel='me'] .pulses path:not(.g-me),
	.map[data-sel='us'] .pulses path:not(.g-us) {
		opacity: 0;
	}
	.map[data-sel='eu'] .ep:not(.g-eu),
	.map[data-sel='me'] .ep:not(.g-me),
	.map[data-sel='us'] .ep:not(.g-us) {
		fill-opacity: 0.25;
	}

	/* Time-based draw (browsers without scroll timelines): with JavaScript, the route waits for the
	   section to enter the viewport, then draws leg by leg; without it, it is simply drawn. */
	:global(.js) .map:not(.is-in) .arc {
		stroke-dashoffset: 1;
	}
	:global(.js) .map:not(.is-in) .ep,
	:global(.js) .map:not(.is-in) .lbl,
	:global(.js) .map:not(.is-in) .pulses {
		opacity: 0;
	}
	:global(.js) .map:not(.is-in) .pulses path {
		animation-play-state: paused;
	}
	:global(.js) .map.is-in .arc {
		stroke-dashoffset: 1;
		animation: zc-draw 1.2s cubic-bezier(0.65, 0, 0.35, 1) forwards;
	}
	:global(.js) .map.is-in .ep,
	:global(.js) .map.is-in .lbl {
		opacity: 0;
		animation: zc-appear 0.9s ease forwards;
	}
	:global(.js) .map.is-in .lbl {
		animation-duration: 1.2s;
	}
	.map.is-in .l0 {
		animation-delay: 0.3s;
	}
	.map.is-in .l1 {
		animation-delay: 0.75s;
	}
	.map.is-in .l2 {
		animation-delay: 1.2s;
	}
	.map.is-in .l3 {
		animation-delay: 1.65s;
	}
	.map.is-in .l4 {
		animation-delay: 2.1s;
	}
	.map.is-in .l5 {
		animation-delay: 2.55s;
	}
	.map.is-in .l6 {
		animation-delay: 3s;
	}
	.map.is-in .l7 {
		animation-delay: 3.45s;
	}
	.map.is-in .l8 {
		animation-delay: 3.9s;
	}
	.map.is-in .l9 {
		animation-delay: 4.35s;
	}
	.map.is-in .e0 {
		animation-delay: 1.95s;
	}
	.map.is-in .e1 {
		animation-delay: 2.4s;
	}
	.map.is-in .e2 {
		animation-delay: 2.85s;
	}
	.map.is-in .e3 {
		animation-delay: 3.3s;
	}
	.map.is-in .e4 {
		animation-delay: 3.75s;
	}
	.map.is-in .e5 {
		animation-delay: 4.2s;
	}
	.map.is-in .e6 {
		animation-delay: 4.65s;
	}
	.map.is-in .e7 {
		animation-delay: 5.1s;
	}
	.map.is-in .e8 {
		animation-delay: 5.55s;
	}
	.map.is-in .t0 {
		animation-delay: 0.4s;
	}
	.map.is-in .t1 {
		animation-delay: 1s;
	}
	.map.is-in .t2 {
		animation-delay: 2s;
	}
	.map.is-in .t3 {
		animation-delay: 2.45s;
	}
	.map.is-in .t4 {
		animation-delay: 2.9s;
	}
	.map.is-in .t5 {
		animation-delay: 3.35s;
	}
	.map.is-in .t6 {
		animation-delay: 3.8s;
	}
	.map.is-in .t7 {
