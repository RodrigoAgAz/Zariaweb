---
import { Image } from 'astro:assets';
import PageIntro from '../PageIntro.astro';
import Paragraphs from '../Paragraphs.astro';
import { getPage, getPeople, valueHtml } from '../../lib/content';
import type { Lang } from '../../lib/routes';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const copy = await getPage<any>('people', lang);
const people = await getPeople();
const slug = (name: string) => name.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-');
---

<PageIntro h1={copy.h1} />

<div class="wrap">
	<ul role="list" class="people">
		{
			people.map((person) => (
				<li class="person" id={slug(person.name)}>
					<div class="person__photo">
						{person.photo ? (
							<Image
								src={person.photo}
								alt={person.name}
								widths={[320, 480, 720]}
								sizes="(min-width: 64em) 22rem, (min-width: 40em) 40vw, 100vw"
								formats={['avif', 'webp']}
							/>
						) : (
							<div class="person__placeholder">
								<span set:html={valueHtml(null, `${copy.missing.photo} ${person.name}`)} />
							</div>
						)}
					</div>
					<div class="person__text">
						<h2>{person.name}</h2>
						<p class="person__title">{person.title[lang]}</p>
						<dl class="person__facts">
							<div>
								<dt>{copy.labels.office}</dt>
								<dd set:html={valueHtml(person.office[lang], `${copy.missing.office}, ${person.name}`)} />
							</div>
							<div>
								<dt>{copy.labels.languages}</dt>
								<dd set:html={valueHtml(person.languages[lang], `${copy.missing.languages}, ${person.name}`)} />
							</div>
						</dl>
						<div class="person__bio prose">
							<Paragraphs items={person.bio[lang]} />
						</div>
					</div>
				</li>
			))
		}
	</ul>
</div>

<style>
	.people {
		margin-block-start: var(--section-space);
	}
	.person + .person {
		margin-block-start: var(--section-space);
		padding-block-start: var(--section-space);
		border-block-start: var(--rule);
	}
	.person {
		display: grid;
		gap: var(--s-6);
	}
	.person__photo {
		max-width: 22rem;
	}
	.person__photo :global(img),
	.person__placeholder {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		filter: grayscale(1);
	}
	.person__placeholder {
		display: grid;
		place-items: center;
		padding: var(--s-5);
		background: var(--zc-fill-lighter);
		border: var(--rule);
		font-size: var(--fs-small);
		text-align: center;
	}
	.person__title {
		margin-block-start: var(--s-2);
		font-size: var(--fs-lead);
		color: var(--zc-text);
	}
	.person__facts {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2) var(--s-7);
		margin-block: var(--s-5);
		padding-block: var(--s-4);
		border-block: var(--rule-faint);
	}
	.person__facts dt {
		font-size: var(--fs-small);
		color: var(--zc-grey-accessible);
	}
	.person__facts dd {
		margin: 0;
	}
	@media (min-width: 40em) {
		.person {
			grid-template-columns: minmax(12rem, 2fr) 3fr;
			column-gap: var(--s-7);
			align-items: start;
		}
	}
	@media (min-width: 64em) {
		.person {
			grid-template-columns: repeat(12, 1fr);
			column-gap: var(--s-6);
		}
		.person__photo {
			grid-column: 1 / span 4;
		}
		.person__text {
			grid-column: 5 / -1;
		}
	}
</style>
