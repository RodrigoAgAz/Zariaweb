---
import PageIntro from '../PageIntro.astro';
import Section from '../Section.astro';
import Paragraphs from '../Paragraphs.astro';
import { getPage } from '../../lib/content';
import type { Lang } from '../../lib/routes';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const copy = await getPage<any>('whatWeDo', lang);
---

<PageIntro h1={copy.h1} lead={copy.lead} />

{
	copy.lines.map((line: any, i: number) => (
		<Section heading={line.name} id={line.anchor} ruled={i > 0}>
			<div class="prose">
				<Paragraphs items={line.paragraphs} />
			</div>
		</Section>
	))
}

<div class="wrap">
	<p class="small notice">{copy.notice}</p>
</div>

<style>
	.notice {
		margin-block-start: var(--section-space);
		padding-block-start: var(--s-5);
		border-block-start: var(--rule);
		max-width: none;
	}
</style>
