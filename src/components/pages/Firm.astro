---
import { getImage } from 'astro:assets';
import PageIntro from '../PageIntro.astro';
import Section from '../Section.astro';
import Paragraphs from '../Paragraphs.astro';
import madridWide from '../../assets/images/madrid-gran-via-bw.jpg';
import madridSquare from '../../assets/images/madrid-gran-via-bw-square.jpg';
import { getPage, getSettings, inline } from '../../lib/content';
import { routes, url, type Lang } from '../../lib/routes';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const copy = await getPage<any>('firm', lang);
const settings = await getSettings();

// The Madrid photograph appears only once Zaria confirms web rights (src/content/settings.yaml).
// Art direction: the 2:1 panorama from 768 px; below that a square crop on the Metrópolis dome and Gran Vía.
let photo: { wide: string; square: string; fallback: { src: string; width: number; height: number } } | null = null;
if (settings.madridPhotoWebRights) {
	const widths = [768, 1200, 1600, 2400];
	const wide = await Promise.all(widths.map((w) => getImage({ src: madridWide, width: w, format: 'avif' })));
	const square = await Promise.all([480, 800, 1200].map((w) => getImage({ src: madridSquare, width: w, format: 'avif' })));
	const fallback = await getImage({ src: madridWide, width: 1600, format: 'jpg' });
	photo = {
		wide: wide.map((img, i) => `${img.src} ${widths[i]}w`).join(', '),
		square: square.map((img, i) => `${img.src} ${[480, 800, 1200][i]}w`).join(', '),
		fallback: { src: fallback.src, width: 1600, height: Math.round((1600 * 1439) / 2914) },
	};
}
---

<PageIntro h1={copy.h1} lead={copy.lead} />

{
	photo && (
		<figure class="firm-photo">
			<picture>
				<source media="(min-width: 48em)" type="image/avif" srcset={photo.wide} sizes="100vw" width="2914" height="1439" />
				<source type="image/avif" srcset={photo.square} sizes="100vw" width="1439" height="1439" />
				<img
					src={photo.fallback.src}
					width={photo.fallback.width}
					height={photo.fallback.height}
					alt={copy.photoAlt}
					decoding="async"
				/>
			</picture>
		</figure>
	)
}

{
	copy.sections.map((section: any, i: number) => (
		<Section heading={section.heading} id={`firm-${i}`} ruled={i > 0}>
			<div class="prose">
				<Paragraphs items={section.paragraphs} />
				{section.link && (
					<p>
						<a href={url(routes.whatWeDo[lang])}>{section.link}</a>
					</p>
				)}
			</div>
		</Section>
	))
}

<Section heading={copy.corridors.heading} id="where-we-work">
	<ul role="list" class="plain-list">
		{copy.corridors.items.map((item: string) => <li>{item}</li>)}
	</ul>
</Section>

<Section heading={copy.clients.heading} id="who-we-work-with">
	<ul role="list" class="plain-list">
		{copy.clients.items.map((item: string) => <li set:html={inline(item)} />)}
	</ul>
</Section>

<style>
	.firm-photo {
		margin-block-start: var(--section-space);
	}
	.firm-photo img {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
	}
	@media (min-width: 48em) {
		.firm-photo img {
			aspect-ratio: 2914 / 1439;
		}
	}
	.plain-list {
		font-size: var(--fs-lead);
		color: var(--zc-logo-ink);
	}
	.plain-list li {
		padding-block: var(--s-2);
		border-block-end: var(--rule-faint);
	}
	.plain-list li:first-child {
		padding-block-start: 0;
	}
</style>
