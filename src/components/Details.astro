---
// Label and value pairs (identification data on the legal pages).
import { inlineOptional, type Tokens } from '../lib/content';
interface Props {
	items: { label: string; value: string }[];
	tokens?: Tokens;
}
const { items, tokens = {} } = Astro.props;
// Rows whose value has not been supplied are left out.
const rows = items
	.map(({ label, value }) => ({ label, html: inlineOptional(value, tokens) }))
	.filter((r): r is { label: string; html: string } => r.html !== null);
---

{
	rows.length > 0 && (
		<dl class="details">
			{
				rows.map(({ label, html }) => (
					<div class="details__row">
						<dt>{label}</dt>
						<dd set:html={html} />
					</div>
				))
			}
		</dl>
	)
}

<style>
	.details {
		border-block-start: var(--rule-faint);
	}
	.details__row {
		display: grid;
		gap: var(--s-1);
		padding-block: var(--s-3);
		border-block-end: var(--rule-faint);
	}
	dt {
		color: var(--zc-grey-accessible);
		font-size: var(--fs-small);
	}
	dd {
		margin: 0;
		font-variant-numeric: lining-nums tabular-nums;
	}
	@media (min-width: 40em) {
		.details__row {
			grid-template-columns: 14rem 1fr;
			column-gap: var(--s-5);
			align-items: baseline;
		}
	}
</style>
