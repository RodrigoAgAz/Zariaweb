---
// The header sits on the dark green ground, so it uses the kit's white logo files.
import mark from '../../brand/logo/svg/zaria-mark-white.svg?url';
import horizontal from '../../brand/logo/svg/zaria-logo-horizontal-white.svg?url';
import { homeSections, languages, routes, url, type Lang, type PageKey } from '../lib/routes';

interface Props {
	lang: Lang;
	page: PageKey | null;
	ui: Record<string, any>;
	/** The 404 page shows the stacked logo in its body instead. */
	showBrand?: boolean;
	/** Home page: the header sits over the hero photograph instead of on its own band. */
	overlay?: boolean;
}
const { lang, page, ui, showBrand = true, overlay = false } = Astro.props;
---

<header class:list={['site-header', 'on-dark', { 'site-header--overlay': overlay }]}>
	<div class="wrap site-header__inner">
		{
			showBrand ? (
				<a class="site-header__brand" href={url(routes.home[lang])} aria-label={ui.homeLabel}>
					<picture>
						<source media="(min-width: 48em)" srcset={horizontal} width="230" height="40" />
						<img src={mark} alt="" width="36" height="30" />
					</picture>
				</a>
			) : (
				<span class="site-header__brand" />
			)
		}
		<nav class="site-nav" aria-label={ui.mainNavLabel}>
			<ul role="list">
				{
					homeSections.map((id) => (
						<li>
							<a href={`${url(routes.home[lang])}#${id}`}>{ui.nav[id]}</a>
						</li>
					))
				}
			</ul>
		</nav>
		<ul class="lang-switch" role="list" aria-label={ui.languageLabel}>
			{
				languages.map((l) =>
					l === lang ? (
						<li>
							<span aria-current="true">
								{ui.current[l].code}
								<span class="visually-hidden">{ui.current[l].hidden}</span>
							</span>
						</li>
					) : (
						<li>
							<a href={url(page ? routes[page][l] : routes.home[l])} lang={l} hreflang={l}>
								{ui.switchTo[l].code}
								<span class="visually-hidden">{ui.switchTo[l].hidden}</span>
							</a>
						</li>
					),
				)
			}
		</ul>
	</div>
</header>

<style>
	.site-header--overlay {
		position: absolute;
		inset-inline: 0;
		inset-block-start: 0;
		z-index: 2;
		background: transparent;
	}
	.site-header__inner {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas:
			'brand lang'
			'nav nav';
		align-items: center;
		row-gap: var(--s-4);
		padding-block: var(--s-5) var(--s-4);
	}
	.site-header__brand {
		grid-area: brand;
		justify-self: start;
		/* Clear space: at least the height of the Z's top bar on every side. */
		padding: 6px;
		margin: -6px;
	}
	.site-header__brand img {
		width: 38px;
		height: auto;
	}
	.site-nav {
		grid-area: nav;
	}
	.site-nav ul {
		display: flex;
		flex-wrap: wrap;
		column-gap: var(--s-5);
		row-gap: var(--s-1);
	}
	.site-nav a,
	.lang-switch a,
	.lang-switch [aria-current] {
		display: inline-block;
		padding-block: var(--s-2);
		color: var(--zc-white);
		text-decoration: none;
		font-size: 1.125rem;
		line-height: 1.2;
	}
	.site-nav a:hover,
	.lang-switch a:hover {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.35em;
	}
	.site-nav a[aria-current='page'] {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.35em;
	}
	.lang-switch {
		grid-area: lang;
		display: flex;
		align-items: center;
		gap: var(--s-2);
	}
	.lang-switch li + li::before {
		content: '/';
		color: var(--zc-logo-ink-soft);
		margin-inline-end: var(--s-2);
	}
	.lang-switch [aria-current] {
		color: var(--zc-grey-light);
	}

	/* Narrowest phones: keep the four items on one row. */
	@media (max-width: 22.5em) {
		.site-nav ul {
			column-gap: var(--s-3);
		}
		.site-nav a {
			font-size: 1.0625rem;
		}
	}

	@media (min-width: 48em) {
		.site-header__inner {
			grid-template-columns: auto 1fr auto;
			grid-template-areas: 'brand nav lang';
			column-gap: var(--s-7);
			padding-block: var(--s-6);
		}
		.site-header__brand img {
			width: 230px;
		}
		.site-nav {
			justify-self: end;
		}
		.site-nav ul {
			column-gap: var(--s-7);
		}
		.site-nav a,
		.lang-switch a,
		.lang-switch [aria-current] {
			font-size: 1.1875rem;
		}
		.lang-switch {
			padding-inline-start: var(--s-6);
			border-inline-start: 1px solid var(--zc-logo-ink-soft);
		}
	}
</style>
